<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The explicit OS version (matching build/Purplemail.iss's own MinVersion=10.0.17763) is
         needed for NuGet to resolve Microsoft.Toolkit.Uwp.Notifications' Windows-specific asset —
         a bare "net9.0-windows" silently falls back to a generic build missing the actual toast
         APIs (ToastContentBuilder.Show, ToastNotificationManagerCompat) instead of failing to
         restore, which is a much more confusing way to discover the mismatch. -->
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyTitle>Purplemail</AssemblyTitle>
    <Product>Purplemail</Product>
    <Description>A desktop email client for IIT Bombay webmail (IMAP/SMTP).</Description>
    <Version>1.0.23</Version>
    <AssemblyVersion>1.0.23.0</AssemblyVersion>
    <FileVersion>1.0.23.0</FileVersion>
    <InformationalVersion>1.0.23</InformationalVersion>
    <Company>Purplemail</Company>
    <Authors>Purplemail</Authors>
    <Copyright>Copyright © 2026</Copyright>
    <NeutralLanguage>en</NeutralLanguage>

    <!-- The exe is what the Run key registers and what the installer ships, so it should carry the
         product name rather than the project's original one. -->
    <AssemblyName>Purplemail</AssemblyName>
    <RootNamespace>EmailClient</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- NuGet packages ship IntelliSense XML alongside their DLLs; those are for developers
         referencing the package, and have no business in an end-user install. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.995" />
    <!-- Already pulled in transitively by HtmlSanitizer (the DOM engine it's built on) — referenced
         directly here too so the reading pane's own conversation-assembly code can use its parser
         to guarantee well-formed output, not just HtmlSanitizer's security-focused tag stripping. -->
    <PackageReference Include="AngleSharp" Version="1.7.1" />
    <PackageReference Include="Ical.Net" Version="5.2.3" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
