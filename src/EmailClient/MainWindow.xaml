<Window x:Class="EmailClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ui="clr-namespace:EmailClient.UI"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Peacock" Height="760" Width="1180" MinWidth="820" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#FFFAFAFA"
        FontFamily="Segoe UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ui:UnreadFontWeightConverter x:Key="UnreadWeight"/>

        <SolidColorBrush x:Key="AccentBrush" Color="#FF6D28D9"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFF3EEFC"/>
        <SolidColorBrush x:Key="AccentDeepBrush" Color="#FF4C1D95"/>
        <LinearGradientBrush x:Key="AvatarBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF8B5CF6" Offset="0"/>
            <GradientStop Color="#FF6D28D9" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round icon-only button, used for refresh/star/reply/etc. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF666666"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF1EDFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowGlyphButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFEDEDED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseGlyphButton" TargetType="Button" BasedOn="{StaticResource WindowGlyphButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FolderRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Margin" Value="8,1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#FFF1F1F1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF3EEFC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFBFAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StarToggle" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="QuickFilterChip" TargetType="ToggleButton">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#FFF4F4F6"/>
            <Setter Property="Foreground" Value="#FF666666"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar (draggable via WindowChrome CaptionHeight) -->
        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource AccentBrush}"/>
                <TextBlock Text="Peacock" Margin="8,0,0,0" Foreground="#FF444444" FontSize="12.5" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource WindowGlyphButton}" Click="MinimizeButton_Click"/>
                <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource WindowGlyphButton}" Click="MaximizeButton_Click"/>
                <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource CloseGlyphButton}" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="White" BorderBrush="#FFE9E9E9" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="ComposeButton" Style="{StaticResource ToolbarButton}" Click="ComposeButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                        <TextBlock Text="Compose"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" x:Name="RefreshButton" Content="&#xE72C;" Style="{StaticResource IconButton}"
                        ToolTip="Refresh" Click="RefreshButton_Click" Margin="0,0,4,0"/>

                <ComboBox Grid.Column="2" x:Name="SortCombo" Width="112" Margin="0,0,12,0" VerticalAlignment="Center"
                          SelectedIndex="0" SelectionChanged="SortCombo_SelectionChanged">
                    <ComboBoxItem Content="Newest first" Tag="Date"/>
                    <ComboBoxItem Content="Sender A–Z" Tag="Sender"/>
                    <ComboBoxItem Content="Subject A–Z" Tag="Subject"/>
                </ComboBox>

                <Border Grid.Column="3" Background="#FFF4F4F6" CornerRadius="8" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#FF999999" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 VerticalAlignment="Center" FontSize="13" Tag="Search mail"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Column="4" x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#FF9A9A9A" FontSize="12"/>

                <Button Grid.Column="5" Content="?" FontWeight="Bold" Style="{StaticResource IconButton}"
                        ToolTip="Keyboard shortcuts" Click="ShortcutsButton_Click"/>

                <Button Grid.Column="6" x:Name="InspectButton" Content="&#xE90F;" Style="{StaticResource IconButton}"
                        ToolTip="Inspect webmail (DevTools) — verify Roundcube selectors" Click="InspectButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Folder sidebar -->
            <Border Grid.Column="0" Background="#FFF8F6FB">
                <StackPanel Margin="0,14">
                    <Border x:Name="FolderInbox" Style="{StaticResource FolderRow}" Background="{StaticResource AccentSoftBrush}"
                            MouseLeftButtonUp="FolderInbox_Click" Tag="Inbox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE715;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AccentDeepBrush}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Inbox" Margin="10,0,0,0" Foreground="{StaticResource AccentDeepBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" x:Name="InboxUnreadBadge" Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock x:Name="InboxUnreadCount" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="FolderSent" Style="{StaticResource FolderRow}" MouseLeftButtonUp="FolderSent_Click" Tag="Sent">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE724;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#FF777777" FontSize="14"/>
                            <TextBlock Text="Sent" Margin="10,0,0,0" Foreground="#FF555555" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="FolderDrafts" Style="{StaticResource FolderRow}" MouseLeftButtonUp="FolderDrafts_Click" Tag="Drafts">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#FF777777" FontSize="14"/>
                            <TextBlock Text="Drafts" Margin="10,0,0,0" Foreground="#FF555555" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="FolderTrash" Style="{StaticResource FolderRow}" MouseLeftButtonUp="FolderTrash_Click" Tag="Trash">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#FF777777" FontSize="14"/>
                            <TextBlock Text="Trash" Margin="10,0,0,0" Foreground="#FF555555" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="#FFEAE5F2" Margin="14,12"/>

                    <Border x:Name="FolderStarred" Style="{StaticResource FolderRow}" MouseLeftButtonUp="FolderStarred_Click" Tag="Starred">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#FFD4A017" FontSize="14"/>
                            <TextBlock Text="Starred" Margin="10,0,0,0" Foreground="#FF555555" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#FFEDEDED"/>

            <!-- Message list -->
            <Grid Grid.Column="2" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="QuickFilterBar" Grid.Row="0" Orientation="Horizontal" Margin="14,10,14,4">
                    <ToggleButton x:Name="FilterAll" Content="All" Style="{StaticResource QuickFilterChip}"
                                  IsChecked="True" Click="QuickFilter_Click" Tag="All"/>
                    <ToggleButton x:Name="FilterUnread" Content="Unread" Style="{StaticResource QuickFilterChip}"
                                  Click="QuickFilter_Click" Tag="Unread"/>
                    <ToggleButton x:Name="FilterStarred" Content="Starred" Style="{StaticResource QuickFilterChip}"
                                  Click="QuickFilter_Click" Tag="Starred"/>
                </StackPanel>

                <Grid x:Name="BulkActionBar" Grid.Row="0" Margin="14,6,10,4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BulkCountText" Grid.Column="0" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource AccentDeepBrush}" FontWeight="SemiBold"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#xE715;" Style="{StaticResource IconButton}" ToolTip="Mark as read" Click="BulkMarkRead_Click"/>
                        <Button Content="&#xE7B8;" Style="{StaticResource IconButton}" ToolTip="Archive" Click="BulkArchive_Click"/>
                        <Button Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="Delete" Click="BulkDelete_Click"/>
                        <Button Content="&#xE711;" Style="{StaticResource IconButton}" ToolTip="Clear selection" Click="BulkClear_Click"/>
                    </StackPanel>
                </Grid>

                <ListBox Grid.Row="1" x:Name="MessageList" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="False"
                         SelectionChanged="MessageList_SelectionChanged"
                         KeyDown="MessageList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,10,0" Tag="{Binding}"
                                          Checked="RowCheck_Changed" Unchecked="RowCheck_Changed"
                                          PreviewMouseLeftButtonDown="StarToggle_PreviewMouseDown"/>

                                <Border Grid.Column="1" Width="34" Height="34" CornerRadius="17"
                                        Background="{StaticResource AvatarBrush}" VerticalAlignment="Top" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0"
                                                     Visibility="{Binding Unread, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding Sender}" FontSize="13"
                                                       FontWeight="{Binding Unread, Converter={StaticResource UnreadWeight}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="&#xE723;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="#FFAAAAAA" Margin="0,0,5,0" VerticalAlignment="Center"
                                                       Visibility="{Binding HasAttachment, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding Date}" Foreground="#FF9A9A9A" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Subject}" FontSize="12" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               FontWeight="{Binding Unread, Converter={StaticResource UnreadWeight}}"/>
                                    <TextBlock Text="{Binding Snippet}" FontSize="11" Foreground="#FFAAAAAA"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Button Grid.Column="3" Style="{StaticResource StarToggle}" VerticalAlignment="Top"
                                        Click="StarToggle_Click" Tag="{Binding}"
                                        PreviewMouseLeftButtonDown="StarToggle_PreviewMouseDown">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE734;"/>
                                                <Setter Property="Foreground" Value="#FFD5D5D5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Starred}" Value="True">
                                                        <Setter Property="Text" Value="&#xE735;"/>
                                                        <Setter Property="Foreground" Value="#FFD4A017"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1" x:Name="ListEmptyState" Text="No messages" Foreground="#FFC5C5C5" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>

            <Border Grid.Column="3" Background="#FFEDEDED"/>

            <!-- Reading pane -->
            <Grid Grid.Column="4" Background="#FFFBFAFC">
                <TextBlock x:Name="EmptyState" Text="Select a message to read"
                           Foreground="#FFC5C5C5" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Border x:Name="ReadingCard" Margin="24" Background="White" CornerRadius="12" Visibility="Collapsed"
                        BorderBrush="#FFEDEDED" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF000000" Opacity="0.05" BlurRadius="18" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="28,24,28,16">
                            <TextBlock x:Name="ReadingSubject" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AvatarBrush}">
                                    <TextBlock x:Name="ReadingAvatarInitial" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ReadingFrom" FontSize="12.5" Foreground="#FF444444"/>
                                    <TextBlock x:Name="ReadingDate" FontSize="11" Foreground="#FF9A9A9A"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="&#xE8CA;" Style="{StaticResource IconButton}" ToolTip="Reply" Click="ReplyButton_Click"/>
                                    <Button Content="&#xE97A;" Style="{StaticResource IconButton}" ToolTip="Reply all" Click="ReplyAllButton_Click"/>
                                    <Button Content="&#xE72D;" Style="{StaticResource IconButton}" ToolTip="Forward" Click="ForwardButton_Click"/>
                                    <Button x:Name="MarkUnreadButton" Content="&#xE715;" Style="{StaticResource IconButton}" ToolTip="Mark as unread" Click="MarkUnreadButton_Click"/>
                                    <Button Content="&#xE7B8;" Style="{StaticResource IconButton}" ToolTip="Archive" Click="ArchiveButton_Click"/>
                                    <Button Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="Delete" Click="DeleteButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="#FFF0F0F0" Margin="28,0"/>

                        <Border x:Name="ImagesBlockedBar" Grid.Row="1" Background="#FFFDF6E3" CornerRadius="6"
                                Margin="28,12,28,0" Padding="12,7" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Images are hidden to protect your privacy" FontSize="12" Foreground="#FF8A6D1D" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Show images" FontSize="12" Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource AccentDeepBrush}" Cursor="Hand" Click="ShowImagesButton_Click"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <wv2:WebView2 x:Name="ReadingPane" Grid.Row="0" Margin="28,16,28,0"/>

                            <ItemsControl x:Name="AttachmentList" Grid.Row="1" Margin="28,14,28,24" Visibility="Collapsed">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,8,8" Padding="10,7" Background="#FFF4F4F6" BorderThickness="0"
                                                Cursor="Hand" Click="Attachment_Click" Tag="{Binding}" ToolTip="Save attachment">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE723;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="12" Foreground="#FF777777" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Size}" FontSize="11" Foreground="#FFAAAAAA"
                                                           VerticalAlignment="Center" Margin="7,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Undo-send snackbar (Gmail-style: sending is delayed a few seconds, cancellable) -->
        <Border x:Name="SendSnackbar" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Margin="24" Background="#FF323232" CornerRadius="8" Padding="16,11" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" Opacity="0.25" BlurRadius="16" ShadowDepth="3"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Message sent" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                <Button Content="UNDO" Margin="24,0,0,0" Background="Transparent" Foreground="#FFC4A6F5" BorderThickness="0"
                        FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="UndoSend_Click"/>
            </StackPanel>
        </Border>

        <!-- Keyboard shortcuts cheat sheet ("?") -->
        <Grid x:Name="ShortcutsOverlay" Grid.RowSpan="3" Background="#88000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="12" Padding="28" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#FF000000" Opacity="0.2" BlurRadius="24" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Keyboard shortcuts" FontSize="16" FontWeight="SemiBold"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                Width="26" Height="26" FontSize="10" Click="CloseShortcutsOverlay_Click"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="c — Compose" Margin="0,4" FontSize="12.5"/>
                            <TextBlock Text="r — Reply" Margin="0,4" FontSize="12.5"/>
                            <TextBlock Text="a — Reply all" Margin="0,4" FontSize="12.5"/>
                            <TextBlock Text="f — Forward" Margin="0,4" FontSize="12.5"/>
                            <TextBlock Text="e — Archive" Margin="0,4" FontSize="12.5"/>
                            <TextBlock Text="# — Delete" Margin="0,4" FontSize="12.5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="j / k — Next / previous" Margin="0,4" FontSize="12.5"/>
                            <TextBlock Text="u — Back to list" Margin="0,4" FontSize="12.5"/>
                            <TextBlock Text="/ — Search" Margin="0,4" FontSize="12.5"/>
                            <TextBlock Text="g then i/s/d/t — Go to folder" Margin="0,4" FontSize="12.5"/>
                            <TextBlock Text="? — This menu" Margin="0,4" FontSize="12.5"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
