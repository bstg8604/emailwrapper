<Window x:Class="EmailClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="IITB Webmail" Height="720" Width="1100"
        Background="#FFFAFAFA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#FF2F6FED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="FlatButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#FFEFEFEF"/>
            <Setter Property="Foreground" Value="#FF222222"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#FFE5E5E5" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ComposeButton" Content="Compose" Style="{StaticResource ToolbarButton}" Click="ComposeButton_Click"/>
                <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource FlatButton}" Click="RefreshButton_Click"/>
                <Button x:Name="InspectButton" Content="Inspect webmail (DevTools)" Style="{StaticResource FlatButton}" Click="InspectButton_Click"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#FF888888" FontSize="12"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Folder sidebar -->
            <Border Grid.Column="0" Background="#FFF3F3F3" BorderBrush="#FFE5E5E5" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,12">
                    <TextBlock Text="Inbox" Padding="16,10" Background="#FFE4ECFC" FontWeight="SemiBold"/>
                    <TextBlock Text="Sent" Padding="16,10" Foreground="#FF666666"/>
                    <TextBlock Text="Drafts" Padding="16,10" Foreground="#FF666666"/>
                    <TextBlock Text="Trash" Padding="16,10" Foreground="#FF666666"/>
                </StackPanel>
            </Border>

            <!-- Message list -->
            <Border Grid.Column="1" BorderBrush="#FFE5E5E5" BorderThickness="0,0,1,0" Background="White">
                <ListBox x:Name="MessageList" BorderThickness="0" SelectionChanged="MessageList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="12,10" Width="310">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding Date}" Foreground="#FF999999" FontSize="11" Margin="8,0,0,0" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Subject}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Snippet}" FontSize="11" Foreground="#FF999999" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Reading pane -->
            <Grid Grid.Column="2" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="20,16">
                    <TextBlock x:Name="ReadingSubject" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ReadingFrom" Foreground="#FF888888" Margin="0,4,0,0"/>
                </StackPanel>
                <wv2:WebView2 x:Name="ReadingPane" Grid.Row="1" Margin="20,0,20,20"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
