<Window x:Class="EmailClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ui="clr-namespace:EmailClient.UI"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Purplemail" Height="760" Width="1180" MinWidth="820" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#FFFAFAFA"
        FontFamily="Segoe UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ui:UnreadFontWeightConverter x:Key="UnreadWeight"/>

        <!-- AccentBrush/AccentSoftBrush/AccentDeepBrush used to be redefined here locally,
             duplicating Theme.xaml's ThemeAccent/ThemeAccentSoft/ThemeAccentDeep (identical
             colours) — now just references the shared ones directly, so the two can't drift. -->
        <!-- The sidebar's "you're here" cue needs to read as stronger than its own hover state,
             not weaker — this is what FolderRow's hover trigger and the active-folder rows below
             (FolderInbox, HighlightFolder, the live folder list's IsActive trigger) both draw from. -->
        <SolidColorBrush x:Key="FolderActiveBrush" Color="#FFE7D9F7"/>
        <LinearGradientBrush x:Key="AvatarBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF8B5CF6" Offset="0"/>
            <GradientStop Color="#FF6D28D9" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{StaticResource ThemeAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round icon-only button, used for refresh/star/reply/etc. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF3C3C3C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="17"/>
                            <!-- Hover fades an overlay in/out rather than swapping Bd's own Background
                                 outright — Bd stays free for any programmatic Background change (a
                                 toggled-active state, say) to keep showing through underneath. -->
                            <Border x:Name="HoverOverlay" Background="#FFF1EDFA" CornerRadius="17"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity"
                                                              To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity"
                                                              To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowGlyphButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFEDEDED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Not just WindowGlyphButton + a Style.Trigger — that trigger loses to WindowGlyphButton's
             own ControlTemplate.Trigger (a template-level Setter beats a Style-level one targeting
             the same templated Background), so hovering Close showed the shared neutral-gray hover
             with dark text instead of red-with-white-text. This gets its own template instead. -->
        <Style x:Key="CloseGlyphButton" TargetType="Button" BasedOn="{StaticResource WindowGlyphButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE81123"/>
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Previously no hover feedback at all — Background was a flat Transparent with no trigger,
             so the sidebar's clickable rows gave zero visual cue until actually clicked. -->
        <Style x:Key="FolderRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Margin" Value="8,1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <!-- Distinct from the sidebar's own #FFF8F6FB background, but visibly weaker than
                     FolderActiveBrush (#FFE7D9F7) — hover is a transient "you're about to click
                     this" cue and shouldn't outshine the "this is the folder you're in" one. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF0EAFA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Previously: selected background (#FFF3EEFC) was nearly white on white, AND the hover
             trigger was listed after IsSelected — since a later trigger wins when both match, the
             even-paler hover colour (#FFFBFAFE) actually washed out the "you have this one open"
             cue whenever the mouse passed over it. Now: a clearer selected tint, an unmissable left
             accent bar (the same cue Slack/Outlook use for "this is the open item"), and IsSelected
             ordered last so it always wins over hover. -->
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0,0,0,1" BorderBrush="#FFF1F1F1">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StarToggle" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="QuickFilterChip" TargetType="ToggleButton">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#FFF4F4F6"/>
            <Setter Property="Foreground" Value="#FF666666"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ThemeAccentSoft}"/>
                                <Setter Property="Foreground" Value="{StaticResource ThemeAccentDeep}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar (draggable via WindowChrome CaptionHeight) -->
        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource ThemeAccent}">
                    <TextBlock Text="&#xE715;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9.5"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Purplemail" Margin="8,0,0,0" Foreground="#FF444444" FontSize="12.5" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" AutomationProperties.Name="Minimize" Content="&#xE921;" Style="{StaticResource WindowGlyphButton}" Click="MinimizeButton_Click"/>
                <Button x:Name="MaximizeButton" AutomationProperties.Name="Maximize" Content="&#xE922;" Style="{StaticResource WindowGlyphButton}" Click="MaximizeButton_Click"/>
                <Button x:Name="CloseButton" AutomationProperties.Name="Close" Content="&#xE8BB;" Style="{StaticResource CloseGlyphButton}" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="White" BorderBrush="#FFE9E9E9" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="ComposeButton" Style="{StaticResource ToolbarButton}" Click="ComposeButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                        <TextBlock Text="Compose"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" x:Name="RefreshButton" Content="&#xE72C;" Style="{StaticResource IconButton}" AutomationProperties.Name="Refresh"
                        ToolTip="Refresh" Click="RefreshButton_Click" Margin="0,0,4,0"/>

                <!-- Icon button instead of a text dropdown — matches Refresh/Signature/Shortcuts
                     next to it instead of being the one text control in an otherwise icon-only
                     toolbar. Opens the same three sort choices as a menu. -->
                <Button Grid.Column="2" x:Name="SortButton" Content="&#xE71C;" Style="{StaticResource IconButton}"
                        ToolTip="Sort" AutomationProperties.Name="Sort" Click="SortButton_Click" Margin="0,0,12,0"/>

                <Border Grid.Column="3" Background="#FFF4F4F6" CornerRadius="8" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#FF999999" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 VerticalAlignment="Center" FontSize="13" Tag="Search mail"
                                 TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                    </Grid>
                </Border>

                <!-- Right-aligned within its stretch column — left-aligned here left a wide dead
                     gap between the (usually short) status text and the icon cluster on a wide or
                     maximized window; right-aligning keeps it visually attached to those icons
                     instead, and pushes any leftover space back next to the search box instead. -->
                <TextBlock Grid.Column="4" x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,12,0"
                           HorizontalAlignment="Right" TextAlignment="Right"
                           Foreground="#FF9A9A9A" FontSize="12" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                <!-- Content is swapped in code between the plain person glyph (signed out) and a
                     small colored avatar with the account's initial (signed in) — same visual
                     language as every message's sender avatar, so "you're signed in" reads at a
                     glance instead of needing to open the menu or read a tooltip to find out.
                     Also where signature editing and Help both live now (the account page's own
                     Signature/Help sections, or once signed in, this button's own menu) instead of
                     separate toolbar buttons. -->
                <Button Grid.Column="5" x:Name="SignInButton" Style="{StaticResource IconButton}"
                        AutomationProperties.Name="Account" Click="SignInButton_Click">
                    <Button.Content>
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"/>
                    </Button.Content>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Folder sidebar -->
            <Border Grid.Column="0" Background="#FFF8F6FB">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,14">
                    <Border x:Name="FolderInbox" Style="{StaticResource FolderRow}" Background="{StaticResource FolderActiveBrush}"
                            MouseLeftButtonUp="FolderInbox_Click" Tag="Inbox"
                            AllowDrop="True" Drop="FolderDrop" DragEnter="FolderDragEnter" DragLeave="FolderDragLeave">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE715;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource ThemeAccentDeep}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Inbox" Margin="10,0,0,0" Foreground="{StaticResource ThemeAccentDeep}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" x:Name="InboxUnreadBadge" Background="{StaticResource ThemeAccent}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock x:Name="InboxUnreadCount" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="FolderSent" Style="{StaticResource FolderRow}" MouseLeftButtonUp="FolderSent_Click" Tag="Sent"
                            AllowDrop="True" Drop="FolderDrop" DragEnter="FolderDragEnter" DragLeave="FolderDragLeave">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE724;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#FF777777" FontSize="14"/>
                            <TextBlock Text="Sent" Margin="10,0,0,0" Foreground="#FF555555" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <!-- A distinct document glyph — this used to share the pencil icon with
                         Compose and "Edit signature", making the sidebar row a step slower to
                         scan at a glance. -->
                    <Border x:Name="FolderDrafts" Style="{StaticResource FolderRow}" MouseLeftButtonUp="FolderDrafts_Click" Tag="Drafts"
                            AllowDrop="True" Drop="FolderDrop" DragEnter="FolderDragEnter" DragLeave="FolderDragLeave">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#FF777777" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Drafts" Margin="10,0,0,0" Foreground="#FF555555" FontSize="13" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" x:Name="DraftsBadge" Background="#FFB9B0C9" CornerRadius="8" Padding="6,1" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="DraftsCount" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="FolderArchive" Style="{StaticResource FolderRow}" MouseLeftButtonUp="FolderArchive_Click" Tag="Archive"
                            AllowDrop="True" Drop="FolderDrop" DragEnter="FolderDragEnter" DragLeave="FolderDragLeave">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#FF777777" FontSize="14"/>
                            <TextBlock Text="Archive" Margin="10,0,0,0" Foreground="#FF555555" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="FolderTrash" Style="{StaticResource FolderRow}" MouseLeftButtonUp="FolderTrash_Click" Tag="Trash"
                            AllowDrop="True" Drop="FolderDrop" DragEnter="FolderDragEnter" DragLeave="FolderDragLeave">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#FF777777" FontSize="14"/>
                            <TextBlock Text="Trash" Margin="10,0,0,0" Foreground="#FF555555" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="#FFEAE5F2" Margin="14,12"/>

                    <Border x:Name="FolderStarred" Style="{StaticResource FolderRow}" MouseLeftButtonUp="FolderStarred_Click" Tag="Starred">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#FFD4A017" FontSize="14"/>
                            <TextBlock Text="Starred" Margin="10,0,0,0" Foreground="#FF555555" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <!-- Every other real IMAP folder, read live out of Roundcube's own sidebar.
                         Stays hidden on sample data, where only the fixed folders above exist. -->
                    <StackPanel x:Name="LiveFolderSection" Visibility="Collapsed">
                        <Border Height="1" Background="#FFEAE5F2" Margin="14,12"/>
                        <TextBlock Text="FOLDERS" Margin="20,0,0,6" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#FFA79BC0"/>
                        <ItemsControl x:Name="LiveFolderList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Tag="{Binding Mailbox}" MouseLeftButtonUp="LiveFolder_Click"
                                            ToolTip="{Binding Mailbox}"
                                            AllowDrop="True" Drop="FolderDrop" DragEnter="FolderDragEnter" DragLeave="FolderDragLeave">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource FolderRow}">
                                                <Style.Triggers>
                                                    <!-- Ordered after the base style's IsMouseOver trigger so the
                                                         active-folder tint always wins over hover, not the other
                                                         way round. -->
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource FolderActiveBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Display}" Foreground="#FF555555" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="{StaticResource ThemeAccent}" CornerRadius="8"
                                                    Padding="6,1" VerticalAlignment="Center"
                                                    Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding Unread}" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="#FFEDEDED"/>

            <!-- Message list -->
            <Grid Grid.Column="2" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="QuickFilterBar" Grid.Row="0" Orientation="Horizontal" Margin="14,10,14,4">
                    <ToggleButton x:Name="FilterAll" Content="All" Style="{StaticResource QuickFilterChip}"
                                  IsChecked="True" Click="QuickFilter_Click" Tag="All"/>
                    <ToggleButton x:Name="FilterUnread" Content="Unread" Style="{StaticResource QuickFilterChip}"
                                  Click="QuickFilter_Click" Tag="Unread"/>
                    <ToggleButton x:Name="FilterStarred" Content="Starred" Style="{StaticResource QuickFilterChip}"
                                  Click="QuickFilter_Click" Tag="Starred"/>
                </StackPanel>

                <Grid x:Name="BulkActionBar" Grid.Row="0" Margin="14,6,10,4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BulkCountText" Grid.Column="0" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource ThemeAccentDeep}" FontWeight="SemiBold"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#xE715;" Style="{StaticResource IconButton}" ToolTip="Mark as read" AutomationProperties.Name="Mark as read" Click="BulkMarkRead_Click"/>
                        <Button Content="&#xE7B8;" Style="{StaticResource IconButton}" ToolTip="Archive" AutomationProperties.Name="Archive selected" Click="BulkArchive_Click"/>
                        <Button x:Name="BulkMoveButton" Content="&#xE8DE;" Style="{StaticResource IconButton}" ToolTip="Move to folder…" AutomationProperties.Name="Move selected to folder" Click="MoveButton_Click"/>
                        <Button Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="Delete" AutomationProperties.Name="Delete selected" Click="BulkDelete_Click"/>
                        <Button Content="&#xE711;" Style="{StaticResource IconButton}" ToolTip="Clear selection" AutomationProperties.Name="Clear selection" Click="BulkClear_Click"/>
                    </StackPanel>
                </Grid>

                <ListBox Grid.Row="1" x:Name="MessageList" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.CacheLengthUnit="Page"
                         VirtualizingPanel.CacheLength="2,2"
                         VirtualizingPanel.IsContainerVirtualizable="True"
                         SelectionChanged="MessageList_SelectionChanged"
                         KeyDown="MessageList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0" Tag="{Binding}" MouseRightButtonUp="MessageRow_ContextMenu"
                                  PreviewMouseLeftButtonDown="MessageRow_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="MessageRow_PreviewMouseMove">
                                <!-- Full-bleed background + left accent bar, driven by the same
                                     AncestorType=ListBoxItem binding pattern the checkbox below
                                     already uses successfully — a ControlTemplate.Trigger on
                                     ListBoxItem.IsSelected wasn't visually taking effect here, so
                                     this sidesteps that instead of chasing why. -->
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                <Setter Property="Background" Value="#FFFBFAFE"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                <Setter Property="Background" Value="#FFEDE0FA"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="Transparent">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource ThemeAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Hidden until bulk-select mode is actually on (or this particular
                                     row is already checked) — no longer shown on hover at all, and
                                     the column itself collapses to zero width rather than reserving
                                     dead space on every row all the time. Entering bulk-select mode
                                     shifting the list over slightly is an acceptable, infrequent
                                     trade for not having a permanent empty gutter. -->
                                <CheckBox Grid.Column="1" VerticalAlignment="Top" Margin="0,14,10,0" Tag="{Binding}"
                                          Checked="RowCheck_Changed" Unchecked="RowCheck_Changed"
                                          PreviewMouseLeftButtonDown="StarToggle_PreviewMouseDown">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=BulkActionBar}" Value="Visible">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>

                                <Border Grid.Column="2" Width="34" Height="34" CornerRadius="17" Margin="10,12,10,0"
                                        Background="{StaticResource AvatarBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="3" Margin="0,12,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource ThemeAccent}" Margin="0,0,6,0"
                                                     Visibility="{Binding Unread, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding Sender}" FontSize="12" Foreground="#FF6B6B6B"
                                                       FontWeight="{Binding Unread, Converter={StaticResource UnreadWeight}}"/>
                                            <Border Background="#FFFBE9D0" CornerRadius="3" Padding="4,0" Margin="6,0,0,0"
                                                    VerticalAlignment="Center" ToolTip="This sender is outside your organization"
                                                    Visibility="{Binding IsExternalSender, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="External" FontSize="9" FontWeight="SemiBold" Foreground="#FFB06A00"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Border Background="{StaticResource ThemeAccentSoft}" CornerRadius="9" Width="18" Height="18"
                                                    Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Has attachment"
                                                    Visibility="{Binding HasAttachment, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE723;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                           Foreground="{StaticResource ThemeAccentDeep}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Date}" Foreground="#FF9A9A9A" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Margin="0,3,0,0" Text="{Binding Subject}" FontSize="13" Foreground="#FF262626"
                                               TextTrimming="CharacterEllipsis"
                                               FontWeight="{Binding Unread, Converter={StaticResource UnreadWeight}}"/>
                                    <TextBlock Text="{Binding Snippet}" FontSize="11" Foreground="#FFAAAAAA"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Button Grid.Column="4" Style="{StaticResource StarToggle}" VerticalAlignment="Top" Margin="0,12,14,0"
                                        Click="StarToggle_Click" Tag="{Binding}"
                                        PreviewMouseLeftButtonDown="StarToggle_PreviewMouseDown">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE734;"/>
                                                <Setter Property="Foreground" Value="#FFD5D5D5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Starred}" Value="True">
                                                        <Setter Property="Text" Value="&#xE735;"/>
                                                        <Setter Property="Foreground" Value="#FFD4A017"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1" x:Name="ListEmptyState" Text="No messages" Foreground="#FFC5C5C5" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                <!-- Roundcube paginates server-side, so only one page of rows ever exists in the
                     live DOM — this bar is how anything past the first page is reachable. -->
                <Border x:Name="PagerBar" Grid.Row="2" BorderBrush="#FFF1F1F1" BorderThickness="0,1,0,0"
                        Padding="10,6" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="PrevPageButton" Content="&#xE76B;" Style="{StaticResource IconButton}"
                                Width="28" Height="28" FontSize="11" ToolTip="Previous page" AutomationProperties.Name="Previous page" Click="PrevPage_Click"/>
                        <TextBlock Grid.Column="1" x:Name="PagerText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="11.5" Foreground="#FF8A8A8A"/>
                        <Button Grid.Column="2" x:Name="NextPageButton" Content="&#xE76C;" Style="{StaticResource IconButton}"
                                Width="28" Height="28" FontSize="11" ToolTip="Next page" AutomationProperties.Name="Next page" Click="NextPage_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="3" Background="#FFEDEDED"/>

            <!-- Reading pane -->
            <Grid Grid.Column="4" Background="#FFFBFAFC">
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="36" Background="#FFF0EBFA" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE715;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28"
                                   Foreground="#FFC3B3EC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Select a message to read" Foreground="#FFB5AFC2" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>

                <Border x:Name="ReadingCard" Margin="16" Background="White" CornerRadius="12" Visibility="Collapsed"
                        BorderBrush="#FFEDEDED" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF000000" Opacity="0.05" BlurRadius="18" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="24,18,24,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ReadingSubject" Grid.Column="0" FontSize="19" FontWeight="SemiBold"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <!-- Grouped rather than seven identical-weight icons in a row: reply
                                     actions, then organize actions, then Delete set apart with extra
                                     spacing — it's the one truly destructive action here and
                                     shouldn't sit flush against Move with nothing to distinguish it. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="&#xE8CA;" Style="{StaticResource IconButton}" ToolTip="Reply" AutomationProperties.Name="Reply" Click="ReplyButton_Click"/>
                                    <Button Content="&#xE97A;" Style="{StaticResource IconButton}" ToolTip="Reply all" AutomationProperties.Name="Reply all" Click="ReplyAllButton_Click"/>
                                    <Button Content="&#xE72D;" Style="{StaticResource IconButton}" ToolTip="Forward" AutomationProperties.Name="Forward" Click="ForwardButton_Click"/>
                                    <Border Width="1" Height="18" Background="#FFEAEAEA" Margin="6,0" VerticalAlignment="Center"/>
                                    <Button x:Name="MarkUnreadButton" Content="&#xE715;" Style="{StaticResource IconButton}" ToolTip="Mark as unread" AutomationProperties.Name="Mark as unread" Click="MarkUnreadButton_Click"/>
                                    <Button Content="&#xE7B8;" Style="{StaticResource IconButton}" ToolTip="Archive" AutomationProperties.Name="Archive" Click="ArchiveButton_Click"/>
                                    <Button x:Name="MoveButton" Content="&#xE8DE;" Style="{StaticResource IconButton}" ToolTip="Move to folder…" AutomationProperties.Name="Move to folder" Click="MoveButton_Click"/>
                                    <Border Width="1" Height="18" Background="#FFEAEAEA" Margin="6,0" VerticalAlignment="Center"/>
                                    <Button Content="&#xE8A5;" Style="{StaticResource IconButton}" ToolTip="View source" AutomationProperties.Name="View message source" Click="ViewSourceButton_Click"/>
                                    <Border Width="1" Height="18" Background="#FFEAEAEA" Margin="6,0" VerticalAlignment="Center"/>
                                    <Button Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="Delete" AutomationProperties.Name="Delete" Click="DeleteButton_Click"/>
                                </StackPanel>
                            </Grid>
                            <!-- Hidden for a multi-message conversation — each card carries its own
                                 from/date header there, so repeating the latest one here too would
                                 just be redundant. The margin lives on this row itself (not a
                                 wrapping element) so collapsing it leaves zero gap behind, keeping
                                 the subject and toolbar on one line with nothing hanging below. -->
                            <StackPanel x:Name="ReadingFromRow" Orientation="Horizontal" Margin="0,10,0,0">
                                <Border x:Name="ReadingAvatarBorder" Width="30" Height="30" CornerRadius="15" Background="{StaticResource AvatarBrush}">
                                    <TextBlock x:Name="ReadingAvatarInitial" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel x:Name="ReadingFromPanel" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ReadingFrom" FontSize="12.5" Foreground="#FF444444"/>
                                    <TextBlock x:Name="ReadingDate" FontSize="11" Foreground="#FF9A9A9A"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="#FFF0F0F0" Margin="24,0"/>

                        <StackPanel Grid.Row="1">
                            <!-- Sent from outside your own organisation's domain — a quiet visual
                                 cue (not a blocker), the same convention Outlook/Gmail use for
                                 "this message is from an external sender". Internal mail shows no
                                 bar at all, so this only ever adds friction where it's warranted. -->
                            <Border x:Name="ExternalSenderBar" Background="#FFEFF3FD" CornerRadius="6"
                                    Margin="24,10,24,0" Padding="10,6" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="12" Foreground="#FF3A5FA0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="This message came from outside your organisation" FontSize="12"
                                               Foreground="#FF3A5FA0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- A Zoom/Meet/Teams link found in the body — surfaced as an actual
                                 meeting card (platform, title, and date/time pulled from the
                                 surrounding text) the way Gmail promotes a calendar invite to the
                                 top, instead of just saying "this message contains a link". -->
                            <Border x:Name="MeetingBar" Background="#FFE9F7EF" CornerRadius="8"
                                    Margin="24,10,24,0" Padding="12,10" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Margin="0,0,10,0"
                                            Background="{StaticResource ThemeAccent}" VerticalAlignment="Center">
                                        <TextBlock x:Name="MeetingBarIcon" Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="MeetingBarTitle" Text="Meeting" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#FF1F3D2C" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="MeetingBarSubtext" Text="Zoom meeting" FontSize="11.5"
                                                   Foreground="#FF4F7A5F" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="JoinMeetingButton" Grid.Column="2" Click="JoinMeetingButton_Click" Cursor="Hand" VerticalAlignment="Center"
                                            Background="Transparent" BorderThickness="0" Padding="0">
                                        <Border Background="{StaticResource ThemeAccent}" CornerRadius="6" Padding="14,7">
                                            <TextBlock Text="Join" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border x:Name="ImagesBlockedBar" Background="#FFFDF6E3" CornerRadius="6"
                                    Margin="24,10,24,0" Padding="10,6" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Images are hidden to protect your privacy" FontSize="12" Foreground="#FF8A6D1D" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Show images" FontSize="12" Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource ThemeAccentDeep}" Cursor="Hand" Click="ShowImagesButton_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Attachments now render inside each message's own card in the HTML
                             (see BuildConversationHtml) instead of in a separate section pinned to
                             the bottom of the pane, disconnected from the message that owns them. -->
                        <Grid Grid.Row="2" Margin="24,12,24,16">
                            <wv2:WebView2 x:Name="ReadingPane"/>
                            <TextBlock x:Name="ReadingPaneLoadingOverlay" Text="Loading…" Foreground="#AAAAAA"
                                       Margin="8,8,0,0" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Undo-send snackbar (Gmail-style: sending is delayed a few seconds, cancellable) -->
        <Border x:Name="SendSnackbar" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Margin="24" Background="#FF323232" CornerRadius="8" Padding="16,11" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" Opacity="0.25" BlurRadius="16" ShadowDepth="3"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SendSnackbarText" Text="Message sent" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                <Button Content="UNDO" Margin="24,0,0,0" Background="Transparent" Foreground="#FFC4A6F5" BorderThickness="0"
                        FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="UndoSend_Click"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
