<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    The app's palette. Every colour the app draws with is named here, and nothing outside this
    file should contain a literal colour — before this existed, 259 hardcoded hex values were
    spread across six XAML files, which is why "add a theme" was previously a rewrite rather than
    a setting.

    Consumers reference these keys with DynamicResource rather than StaticResource, so swapping
    this dictionary at runtime is all an alternative palette would take. (A dark palette was
    built and backed out: it loaded but left the main window never becoming visible, and light is
    what actually gets used.)

    Each token exists twice: "<Name>Color" for the few places XAML needs a Color (gradient stops,
    colour animations) and "<Name>" as the SolidColorBrush that almost everything actually uses.
    -->

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FF1F1F1F</Color>
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}"/>
    <Color x:Key="TextBodyColor">#FF3C3C3C</Color>
    <SolidColorBrush x:Key="TextBody" Color="{StaticResource TextBodyColor}"/>
    <Color x:Key="TextSecondaryColor">#FF555555</Color>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
    <Color x:Key="TextMutedColor">#FF9A9A9A</Color>
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}"/>
    <Color x:Key="TextDisabledColor">#FFB6B6C0</Color>
    <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}"/>
    <Color x:Key="TextOnAccentColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="TextOnAccent" Color="{StaticResource TextOnAccentColor}"/>
    <!-- Surfaces -->
    <Color x:Key="SurfaceCardColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="SurfaceCard" Color="{StaticResource SurfaceCardColor}"/>
    <Color x:Key="SurfaceAppColor">#FFF6F5F9</Color>
    <SolidColorBrush x:Key="SurfaceApp" Color="{StaticResource SurfaceAppColor}"/>
    <Color x:Key="SurfaceAltColor">#FFFBFAFC</Color>
    <SolidColorBrush x:Key="SurfaceAlt" Color="{StaticResource SurfaceAltColor}"/>
    <Color x:Key="SurfaceSunkenColor">#FFF3F3F5</Color>
    <SolidColorBrush x:Key="SurfaceSunken" Color="{StaticResource SurfaceSunkenColor}"/>
    <Color x:Key="SurfaceHoverColor">#FFEDEDED</Color>
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}"/>
    <Color x:Key="SurfaceSelectedColor">#FFF1EDFA</Color>
    <SolidColorBrush x:Key="SurfaceSelected" Color="{StaticResource SurfaceSelectedColor}"/>
    <!-- Borders -->
    <Color x:Key="BorderSubtleColor">#FFEDEDF2</Color>
    <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}"/>
    <Color x:Key="BorderColor">#FFE2E2E8</Color>
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}"/>
    <Color x:Key="BorderStrongColor">#FFD5D5D5</Color>
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}"/>
    <Color x:Key="BorderHoverColor">#FFC9C0E8</Color>
    <SolidColorBrush x:Key="BorderHover" Color="{StaticResource BorderHoverColor}"/>
    <!-- Accent -->
    <Color x:Key="AccentColor">#FF6D28D9</Color>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <Color x:Key="AccentDeepColor">#FF4C1D95</Color>
    <SolidColorBrush x:Key="AccentDeep" Color="{StaticResource AccentDeepColor}"/>
    <Color x:Key="AccentLightColor">#FF8B5CF6</Color>
    <SolidColorBrush x:Key="AccentLight" Color="{StaticResource AccentLightColor}"/>
    <Color x:Key="AccentPaleColor">#FFC4A6F5</Color>
    <SolidColorBrush x:Key="AccentPale" Color="{StaticResource AccentPaleColor}"/>

    <!-- A desaturated step down from Accent/AccentLight, specifically for the sender-initial
         avatar circle in the message list and reading pane. The full-saturation pair read as too
         intense once repeated down a whole inbox of rows — this keeps the same purple identity at
         a calmer intensity, confirmed still comfortably legible with the avatar's white initial
         letter at the actual ~34px size it's drawn at. -->
    <Color x:Key="AvatarGradientStartColor">#FFA082D0</Color>
    <SolidColorBrush x:Key="AvatarGradientStart" Color="{StaticResource AvatarGradientStartColor}"/>
    <Color x:Key="AvatarGradientEndColor">#FF7E5DB0</Color>
    <SolidColorBrush x:Key="AvatarGradientEnd" Color="{StaticResource AvatarGradientEndColor}"/>
    <Color x:Key="AccentSoftColor">#FFF3EEFC</Color>
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}"/>
    <Color x:Key="AccentSofterColor">#FFFAF9FD</Color>
    <SolidColorBrush x:Key="AccentSofter" Color="{StaticResource AccentSofterColor}"/>
    <Color x:Key="AccentMutedColor">#FFA79BC0</Color>
    <SolidColorBrush x:Key="AccentMuted" Color="{StaticResource AccentMutedColor}"/>
    <!-- Status -->
    <Color x:Key="DangerColor">#FFE81123</Color>
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}"/>
    <Color x:Key="DangerDeepColor">#FFB91C1C</Color>
    <SolidColorBrush x:Key="DangerDeep" Color="{StaticResource DangerDeepColor}"/>
    <Color x:Key="DangerSoftColor">#FFFDEDED</Color>
    <SolidColorBrush x:Key="DangerSoft" Color="{StaticResource DangerSoftColor}"/>
    <Color x:Key="WarningColor">#FFD4A017</Color>
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}"/>
    <Color x:Key="WarningDeepColor">#FFB06A00</Color>
    <SolidColorBrush x:Key="WarningDeep" Color="{StaticResource WarningDeepColor}"/>
    <Color x:Key="WarningSoftColor">#FFFDF6E3</Color>
    <SolidColorBrush x:Key="WarningSoft" Color="{StaticResource WarningSoftColor}"/>
    <Color x:Key="SuccessColor">#FF4F7A5F</Color>
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}"/>
    <Color x:Key="SuccessDeepColor">#FF1F3D2C</Color>
    <SolidColorBrush x:Key="SuccessDeep" Color="{StaticResource SuccessDeepColor}"/>
    <Color x:Key="SuccessSoftColor">#FFE9F7EF</Color>
    <SolidColorBrush x:Key="SuccessSoft" Color="{StaticResource SuccessSoftColor}"/>
    <Color x:Key="InfoColor">#FF3A5FA0</Color>
    <SolidColorBrush x:Key="Info" Color="{StaticResource InfoColor}"/>
    <Color x:Key="InfoSoftColor">#FFEFF3FD</Color>
    <SolidColorBrush x:Key="InfoSoft" Color="{StaticResource InfoSoftColor}"/>
    <Color x:Key="HighlightColor">#FFFFF176</Color>
    <SolidColorBrush x:Key="Highlight" Color="{StaticResource HighlightColor}"/>
    <!-- Chrome -->
    <Color x:Key="ScrollThumbColor">#FFD3D0DC</Color>
    <SolidColorBrush x:Key="ScrollThumb" Color="{StaticResource ScrollThumbColor}"/>

    <!-- Set on the active row of the account window's sidebar from code-behind, which is why it
         needs a name of its own rather than living in a style. -->
    <Color x:Key="NavActiveColor">#FFE7D9F7</Color>
    <SolidColorBrush x:Key="NavActive" Color="{StaticResource NavActiveColor}"/>

    <!-- Legacy names kept because they are referenced across every window; the same colours as the
         Accent/Border tokens above, under the names the existing XAML already uses. -->
    <SolidColorBrush x:Key="ThemeAccent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ThemeAccentSoft" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="ThemeAccentDeep" Color="{StaticResource AccentDeepColor}"/>
    <SolidColorBrush x:Key="ThemeBorder" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ThemeBorderHover" Color="{StaticResource BorderHoverColor}"/>

</ResourceDictionary>
