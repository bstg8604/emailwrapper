<Window x:Class="EmailClient.UI.AttachmentViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Attachment" Height="720" Width="900" MinWidth="480" MinHeight="360"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource SurfaceCard}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceSunken}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseGlyphButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Danger}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource TextDisabled}" BorderThickness="1" CornerRadius="8">
        <Grid Background="{DynamicResource SurfaceApp}">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar doubles as the toolbar -->
            <Grid Grid.Row="0" Background="{DynamicResource SurfaceCard}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="FileGlyph" Text="&#xE723;" Margin="16,0,0,0"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="FileSizeText" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="10,1,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="SaveButton" Style="{StaticResource BarButton}"
                            AutomationProperties.Name="Save a copy" Click="SaveButton_Click" Content="Save a copy"/>
                    <Button x:Name="OpenExternallyButton" Style="{StaticResource BarButton}"
                            AutomationProperties.Name="Open in default app" Click="OpenExternallyButton_Click"
                            Content="Open externally"/>
                </StackPanel>

                <Button Grid.Column="3" Content="&#xE8BB;" Style="{StaticResource CloseGlyphButton}"
                        AutomationProperties.Name="Close" Click="CloseButton_Click"/>
            </Grid>
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource SurfaceSunken}"/>

            <Grid Grid.Row="1" Background="{DynamicResource SurfaceAlt}">
                <wv2:WebView2 x:Name="Viewer" Visibility="Collapsed"/>

                <!-- Shown for file types that can't be rendered safely inline -->
                <StackPanel x:Name="FallbackPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed" MaxWidth="380">
                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40"
                               Foreground="{DynamicResource BorderStrong}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="FallbackTitle" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    <TextBlock x:Name="FallbackDetail" FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,0"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="LoadingText" Text="Opening…" Foreground="{DynamicResource TextDisabled}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
